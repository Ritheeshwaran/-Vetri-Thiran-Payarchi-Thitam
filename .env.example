# Required for Gemini-powered features
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Current Gemini model. If your account does not expose this model,
# change it to another model available in Google AI Studio.
GEMINI_MODEL=gemini-3.8-flash

# "gemini" is recommended for the easiest setup.
# Set to "local" only after installing requirements-local.txt.
EXPLANATION_PROVIDER=gemini
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M

APP_NAME=EduGenie
DEMO_MODE=false
